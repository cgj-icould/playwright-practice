{
  "openapi": "3.0.0",
  "info": {
    "title": "API Test Framework Demo",
    "version": "1.0.0",
    "description": "模拟的用户管理系统接口文档"
  },
  "paths": {
    "/api/login": {
      "post": {
        "summary": "用户登录",
        "description": "接收 email 和 password，成功返回 token，失败返回 401",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "用户邮箱"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 6,
                    "description": "用户密码"
                  }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功"
          },
          "400": {
            "description": "参数缺失或格式错误"
          },
          "401": {
            "description": "账号或密码错误"
          }
        }
      }
    },
    "/api/register": {
      "post": {
        "summary": "用户注册",
        "description": "注册新用户，需要 email, password, 和 username",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "description": "邮箱"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "description": "密码，至少8位"
                  },
                  "username": {
                    "type": "string",
                    "description": "用户名"
                  }
                },
                "required": ["email", "password", "username"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "注册成功"
          },
          "400": {
            "description": "参数校验失败"
          }
        }
      }
    }
  }
}